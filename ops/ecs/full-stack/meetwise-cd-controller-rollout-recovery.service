[Unit]
Description=Recover an interrupted Meetwise controller rollout before application publication
After=local-fs.target
Before=meetwise-full-stack-publication-recovery.service meetwise-full-stack-edge-restore.service nginx.service
ConditionPathExists=/usr/local/sbin/meetwise-cd-root

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/local/sbin/meetwise-cd-root controller-recover
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
