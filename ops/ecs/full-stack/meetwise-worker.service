[Unit]
Description=Meetwise preview Worker
After=network-online.target meetwise-api.service
Wants=network-online.target

[Service]
Type=simple
User=meetwise
Group=meetwise
WorkingDirectory=/srv/meetwise-full-stack/current/apps/worker
EnvironmentFile=/etc/meetwise/full-stack-common.env
EnvironmentFile=/etc/meetwise/full-stack-worker.env
EnvironmentFile=/etc/meetwise/tair-app.env
ExecStart=/usr/bin/node --import @swc-node/register/esm-register src/main.ts
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
KillSignal=SIGTERM
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/srv/meetwise-full-stack
ReadWritePaths=/var/lib/meetwise-full-stack
MemoryMax=1G
TasksMax=384

[Install]
WantedBy=multi-user.target
