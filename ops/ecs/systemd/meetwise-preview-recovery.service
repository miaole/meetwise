[Unit]
Description=Meetwise preview publication recovery gate
After=network-online.target tailscaled.service
Wants=network-online.target tailscaled.service
Before=meetwise-web-preview.service

[Service]
Type=oneshot
ExecStart=/usr/local/lib/meetwise-preview-controller/recover-preview-publication.sh
RemainAfterExit=yes
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ReadWritePaths=/usr/share/meetwise-preview /var/lib/meetwise-preview-controller /run/meetwise-preview-controller /srv/meetwise-preview /etc/meetwise
InaccessiblePaths=/srv/meetwise
CapabilityBoundingSet=
AmbientCapabilities=
UMask=0077

[Install]
WantedBy=multi-user.target
