{
  "schemaVersion": 1,
  "neverWeaken": true,
  "releaseEvidence": false,
  "floors": {
    "e2e/full.e2e.ts": { "pattern": "\\bA\\(", "min": 57 },
    "e2e/helpers/e2e-helpers.proof.ts": { "pattern": "^(?:await )?test\\(", "min": 9 },
    "e2e/helpers/interview.ts": { "pattern": "options\\.assert\\(", "min": 4 }
  },
  "requiredPackageScripts": [
    "e2e:isolated",
    "e2e:ui:isolated",
    "regression",
    "e2e-helpers:prove",
    "e2e-platform:check",
    "e2e-platform:prove",
    "e2e-platform:layout:prove",
    "e2e-static-guards:check",
    "e2e-static-guards:prove",
    "e2e-parity:check",
    "e2e-parity:prove",
    "e2e-receipt:prove",
    "generation-trust:prove",
    "golden-tasks:check"
  ]
}
