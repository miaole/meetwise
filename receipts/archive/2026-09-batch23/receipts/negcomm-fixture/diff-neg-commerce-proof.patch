+  END IF;
+
+  IF NEW.resume_id IS DISTINCT FROM OLD.resume_id THEN
+    -- Ordinary C interviews are created before /begin knows the selected
+    -- resume.  Allow exactly one NULL -> owned/ingested resume assignment in
