+    IF OLD.application_id IS NULL
+       AND NEW.application_id IS NULL
+       AND OLD.resume_id IS NULL
+       AND NEW.resume_id IS NOT NULL
+       AND OLD.status='created' THEN
+      PERFORM 1 FROM resume r
+       WHERE r.id=NEW.resume_id
