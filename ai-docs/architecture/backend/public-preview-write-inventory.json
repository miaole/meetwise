      "path": "/interview",
      "source": "apps/api/src/modules/interview/interview.controller.ts",
      "handler": "create",
      "writes": ["interview"],
      "stateClass": "interview",
      "fences": ["http-method-ingress", "service-write-fence"],
      "disposition": "fenced"
    },
    {
      "id": "api-interview-begin",
