{
  "schemaVersion": 1,
  "id": "public-preview-write-inventory",
  "mode": "observe-and-fence",
  "releaseEvidence": false,
  "statement": "静态清单只枚举当前仓库里能写面试或评分状态的公开/预览可达面，并要求每条面都有失败关闭围栏。它不证明 ECS 监听器、镜像摘要、健康回执或发布。",
  "scope": "interview-and-scoring-state",
  "requiredFenceKinds": [
    "http-method-ingress",
    "web-middleware",
    "service-write-fence",
    "preview-controlled-write",
    "disabled-no-write",
    "internal-not-public"
  ],
  "readOnlyGetHandlers": {
    "apps/api/src/modules/interview/interview.controller.ts": [
      "list",
      "get",
      "report",
      "exportReport",
      "transcript",
      "getAssessment",
      "getLearningPlan",
      "getCareerPath",
      "events"
    ]
  },
  "writeSqlPatterns": [
    "INSERT INTO interview",
    "INSERT INTO interview_job",
    "INSERT INTO interview_event",
    "INSERT INTO interview_question",
    "INSERT INTO assessment_report",
    "INSERT INTO score_card",
    "enqueueInterviewJob",
    "submitInterviewAnswer",
    "writeFinalScoreCard",
    "requeueFailedReport",
    "startApplicationInterview",
    "claimInterviewAnswer"
  ],
  "surfaces": [
    {
      "id": "api-interview-create",
