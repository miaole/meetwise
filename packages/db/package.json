    "commerce": "tsx test/commerce-saga.proof.ts",
    "resume": "tsx test/resume-ingest.proof.ts",
    "recruiter": "tsx test/recruiter-depth.proof.ts",
    "growth": "tsx test/growth.proof.ts",
    "prove:vectorstore": "tsx test/vectorstore.proof.ts",
    "prove:migrate": "tsx test/migrate.proof.ts",
    "prove:migrate-cli": "tsx test/migrate-cli.proof.ts",
    "prove:qbank-control-role": "tsx test/qbank-control-role.proof.ts",
    "prove:qbank-source": "tsx test/qbank-control-role.proof.ts",
    "prove:qbank-cache": "tsx test/qbank-retrieval-cache.proof.ts",
    "prove:rag-corpus-version": "tsx test/rag-corpus-version.proof.ts",
    "prove:rag-control-role": "tsx test/rag-control-role.proof.ts",
    "prove:rag-control-upgrade": "tsx test/rag-control-upgrade.proof.ts",
    "prove:rag-control-dispatch": "tsx test/rag-control-dispatch.proof.ts",
    "prove:ai-cost": "tsx test/ai-cost-governance.proof.ts",
    "prove:runtime-role": "tsx test/runtime-role.proof.ts",
    "prove:principal-config": "tsx test/principal-config.proof.ts",
    "prove:isolated-target": "tsx test/isolated-test-target.proof.ts",
    "migrate": "tsx src/migrate-cli.ts"
  },
  "dependencies": {
    "pg": "catalog:"
  },
  "devDependencies": {
    "@types/pg": "catalog:",
    "typescript": "catalog:",
    "tsx": "^4.22.4",
    "@types/node": "catalog:",
    "@meetwise/domain": "workspace:*"
  }
}
