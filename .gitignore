.DS_Store
node_modules/
.pnpm-store/
dist/
build/
.next/
.turbo/
coverage/

.env
.env.*
!.env.example
!*.env.example

.tmp/
docker/data/

# 本地设置不进开源仓库（保留 .claude/skills/ 可提交）
.claude/settings.local.json

# 手动 live smoke 的本地素材(音频/图片/嵌入缓存),不进仓库
.smoke/

# 本地工具状态/重复目录,不进开源仓库
.playwright-mcp/
.agents/

# ECS 预览运行时状态(含真实云端点/实例标识),不进开源仓库;模板见 .example

# Python 编译产物(含内嵌本机绝对路径),不进开源仓库
__pycache__/
*.pyc

# 构建测试副产不进仓库(REPO-HYGIENE 刀·两件已 git rm --cached untrack):
# test-results/ = Playwright outputDir(默认 ./test-results·含 .last-run.json 簿记与失败产物)
# *.tsbuildinfo = tsc incremental 增量索引(apps/web/tsconfig.json incremental:true 副产·内嵌 clone 路径指纹)
test-results/
*.tsbuildinfo
# preview-site/ = 本地预览部署残料（preview-manifest-origin.txt 单行 URL·非仓库内容·2026-11-07 门禁批刀随批处理）
preview-site/
# .mimosa/ = mimosa 插件 hook 会话态/finding ledger（运行时产物·非仓库内容）
.mimosa/
apps/api/.mimosa/
# 本地工具状态/传输残料不进仓库(2026-11-07 i6-gates 预跑发现未跟踪杂物污染改动集·只 ignore 不删):
# .sync/ = git bundle 同步传输残料; .playwright-cli/ = 控制台日志; output/ = playwright 输出;
# .zcodeignore = ZCode 本地工作区忽略配置(仅本地态)
.sync/
.playwright-cli/
output/
.zcodeignore
