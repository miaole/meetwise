{
  "name": "@meetwise/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "serve": "node --import @swc-node/register/esm-register src/main.ts",
    "validate": "node --import @swc-node/register/esm-register test/validate.ts",
    "smoke:toolchain": "node --import @swc-node/register/esm-register test/toolchain.smoke.ts",
    "smoke:contract": "node --import @swc-node/register/esm-register test/contract.smoke.ts",
    "smoke:display-names": "node --import @swc-node/register/esm-register test/resume-display.proof.ts",
    "neg:auth": "node --import @swc-node/register/esm-register test/neg-auth.proof.ts",
    "neg:commerce": "node --import @swc-node/register/esm-register test/neg-commerce.proof.ts",
    "neg:resume": "node --import @swc-node/register/esm-register test/neg-resume.proof.ts",
    "neg:interview": "node --import @swc-node/register/esm-register test/neg-interview.proof.ts",
    "neg:bend": "node --import @swc-node/register/esm-register test/neg-bend.proof.ts",
    "neg:input": "node --import @swc-node/register/esm-register test/neg-input.proof.ts",
    "turn-idempotency:prove": "PORT=0 node --import @swc-node/register/esm-register test/turn-idempotency.proof.ts",
    "prove:runtime-role-http": "node --import @swc-node/register/esm-register test/runtime-role-http.proof.ts",
    "prove:privacy-erasure-http": "node --import @swc-node/register/esm-register test/privacy-erasure-http.proof.ts",
    "prove:scor-00-http": "node --import @swc-node/register/esm-register test/scor-00-http-db.proof.ts",
    "prove:voice-timeout": "node --import @swc-node/register/esm-register test/voice-timeout.proof.ts",
    "prove:voice-operation-policy": "tsx test/voice-operation-policy.proof.ts",
    "prove:voice-cancel-http": "tsx test/voice-cancel-http.proof.ts",
    "prove:ocr-operation-policy": "tsx test/ocr-operation-policy.proof.ts",
    "prove:public-preview-write-gate": "node --import ./node_modules/@swc-node/register/esm/esm-register.mjs test/public-preview-write-gate.proof.ts",
    "prove:int-transcript-preview-submit-http": "node --import ./node_modules/@swc-node/register/esm/esm-register.mjs test/int-transcript-preview-submit-http.proof.ts",
    "prove:resume-reference-http": "node --import @swc-node/register/esm-register test/resume-reference-http.proof.ts",
    "neg:all": "for g in auth commerce resume interview bend input; do node --import @swc-node/register/esm-register test/neg-$g.proof.ts || exit 1; done"
  },
  "dependencies": {
    "@meetwise/db": "workspace:*",
    "@meetwise/contracts": "workspace:*",
    "@nestjs/common": "^11.1.27",
    "@nestjs/core": "^11.1.27",
    "@nestjs/platform-fastify": "^11.1.27",
    "fastify": "5.8.5",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "catalog:",
    "@meetwise/domain": "workspace:*",
    "@meetwise/ai-runtime": "workspace:*"
  },
  "devDependencies": {
    "@swc-node/register": "^1.11.1",
    "@swc/core": "^1.15.43",
    "@types/node": "catalog:",
    "typescript": "catalog:"
  }
}
