{
  "name": "meetwise",
  "private": true,
  "packageManager": "pnpm@10.18.0",
  "scripts": {
    "docs:check": "node scripts/ai-docs/check-docs.mjs",
    "db:up": "docker compose -f docker/compose.dev.yml up -d postgres",
    "db:prove": "pnpm -C packages/db prove",
    "runtime:prove": "pnpm -C packages/ai-runtime prove",
    "graph:prove": "pnpm -C apps/worker prove:resume",
    "pipeline:prove": "pnpm -C packages/ai-graphs prove:pipeline",
    "api:validate": "pnpm -C apps/api validate",
    "api:smoke": "pnpm -C apps/api smoke:toolchain && pnpm -C apps/api smoke:contract",
    "dev": "bash scripts/dev-up.sh",
    "compose:demo": "docker compose -f docker/compose.demo.yml up --build",
    "compose:down": "docker compose -f docker/compose.demo.yml down",
    "arch": "depcruise --config .dependency-cruiser.cjs apps packages",
    "commerce:prove": "pnpm -C packages/db commerce",
    "resume:prove": "pnpm -C packages/db resume",
    "recruiter:prove": "pnpm -C packages/db recruiter",
    "growth:prove": "pnpm -C packages/db growth",
    "report:prove": "pnpm -C apps/worker prove:report",
    "web:prove": "pnpm -C apps/web prove",
    "flow:prove": "pnpm -C apps/worker prove:flow",
    "model:smoke": "pnpm -C apps/worker exec tsx smoke/model-live-smoke.ts",
    "flow:live": "pnpm -C apps/worker exec tsx smoke/flow-live.ts",
    "vl:smoke": "pnpm -C apps/worker exec tsx smoke/vl-smoke.ts",
    "voice:prove": "pnpm -C apps/worker prove:voice",
    "asr:smoke": "pnpm -C apps/worker exec tsx smoke/asr-smoke.ts",
    "voice:live": "pnpm -C apps/worker exec tsx smoke/voice-live.ts",
    "voice:loop": "pnpm -C apps/worker exec tsx smoke/voice-loop.ts",
    "interview:prove": "pnpm -C apps/worker prove:interview",
    "stress:prove": "pnpm -C apps/worker prove:stress",
    "quiz:prove": "pnpm -C apps/worker prove:quiz",
    "diagnosis:prove": "pnpm -C apps/worker prove:diagnosis",
    "reaper:prove": "pnpm -C apps/worker prove:reaper",
    "recall:eval": "pnpm -C apps/worker exec tsx smoke/recall-eval.ts",
    "benchmark:eval": "pnpm -C apps/worker exec tsx smoke/benchmark-eval.ts",
    "retrieval:prove": "pnpm -C packages/ai-runtime prove:retrieval",
    "retrieval:benchmark": "pnpm -C apps/worker exec tsx smoke/retrieval-benchmark.ts",
    "chunk:eval": "pnpm -C apps/worker exec tsx smoke/chunk-eval.ts",
    "security:prove": "pnpm -C apps/worker prove:security",
    "vectorstore:prove": "pnpm -C packages/db prove:vectorstore",
    "map:eval": "pnpm -C apps/worker exec tsx smoke/map-eval.ts",
    "memory:prove": "pnpm -C apps/worker prove:memory",
    "deploy:check": "docker compose -f docker/compose.prod.yml config -q && node scripts/deploy-check.mjs",
    "rag:demo": "pnpm -C apps/worker exec tsx smoke/rag-demo.ts",
    "auth:prove": "pnpm -C packages/domain prove:auth",
    "openapi:prove": "pnpm -C packages/contracts prove:openapi",
    "e2e:prove": "node scripts/run-e2e.mjs",
    "e2e:ui": "node scripts/run-e2e-ui.mjs",
    "migrate:prove": "pnpm -C packages/db prove:migrate",
    "breaker:prove": "pnpm -C packages/ai-runtime prove:breaker",
    "vstream:prove": "pnpm -C packages/ai-runtime prove:vstream",
    "drain:prove": "pnpm -C apps/worker prove:drain",
    "metrics:prove": "pnpm -C packages/ai-runtime prove:metrics",
    "adaptive:prove": "pnpm -C packages/domain prove:adaptive",
    "adaptive-redesign:prove": "pnpm -C packages/domain prove:adaptive-redesign",
    "grounded:prove": "pnpm -C packages/domain prove:grounded",
    "crag:prove": "pnpm -C packages/domain prove:crag",
    "tools:prove": "pnpm -C packages/ai-runtime prove:tools",
    "adaptive-graph:prove": "pnpm -C packages/ai-graphs prove:adaptive-graph",
    "critique:prove": "pnpm -C packages/domain prove:critique",
    "adaptive-flow:prove": "pnpm -C apps/worker prove:adaptive-flow",
    "adaptive-life:prove": "pnpm -C apps/worker prove:adaptive-life",
    "adaptive-consumer:prove": "pnpm -C apps/worker prove:adaptive-consumer",
    "web-explore:prove": "pnpm -C packages/domain prove:web-explore",
    "voice-adaptive:prove": "pnpm -C apps/worker prove:voice-adaptive",
    "qbank:prove": "pnpm -C apps/worker prove:qbank",
    "qbank-pipeline:prove": "pnpm -C apps/worker prove:qbank-pipeline",
    "adaptive-degrade:prove": "pnpm -C apps/worker prove:adaptive-degrade",
    "adaptive-offtopic:prove": "pnpm -C apps/worker prove:adaptive-offtopic",
    "adaptive-latency:prove": "pnpm -C apps/worker prove:adaptive-latency",
    "resume-extract:prove": "pnpm -C packages/domain prove:resume-extract",
    "window:prove": "pnpm -C apps/worker prove:window"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "dependency-cruiser": "^18.0.0",
    "tsx": "^4.22.4",
    "turbo": "^2.10.0",
    "typescript": "catalog:"
  }
}
