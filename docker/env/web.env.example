NEXT_PUBLIC_APP_NAME=Meetwise
NEXT_PUBLIC_APP_CN_NAME=知面
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001
NEXT_PUBLIC_ENABLE_MOCK_AI=true
# Preview-only resume OCR UI. Exact '1' on both flags, and not production /
# MODEL_COST_ENFORCEMENT=enforce / MEETWISE_PUBLIC_PREVIEW=1. API must match.
# These two lock vars must be set on the web process as well as API (staging
# parity). Production compose defaults enforcement to enforce.
# API preview invoke + 0127 are on main. Not a visual SLO.
OCR_ENABLED=0
OCR_PREVIEW=0
# Stream ASR / server turn-taking preview. Exact '1' on both, and not
# production / enforce / public-preview. Flags do not invent a transcript
# or wire a browser stream path. Product UI stays on batch /speak + /transcribe.
VOICE_STREAM_ASR_ENABLED=0
VOICE_STREAM_ASR_PREVIEW=0
MODEL_COST_ENFORCEMENT=0
MEETWISE_PUBLIC_PREVIEW=0
