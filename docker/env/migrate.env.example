# One-time migration/provisioning service only — never mount these variables
# into API or Worker containers. Values are injected by the secret manager;
# leave this committed template empty and do not copy real credentials here.
DATABASE_URL=
DATABASE_SSL_MODE=verify-full
DATABASE_SSL_CA_PATH=/run/secrets/rds_ca

# Each login is unique. The migration CLI provisions these roles and, when the
# generic RAG pair is present, immediately verifies its low-privilege identity
# and full SECURITY DEFINER/RLS catalog manifest through that login.
APP_RUNTIME_DB_USER=
APP_RUNTIME_DB_PASSWORD=
QBANK_CONTROL_DB_USER=
QBANK_CONTROL_DB_PASSWORD=
PRIVACY_WORKER_DB_USER=
PRIVACY_WORKER_DB_PASSWORD=
RAG_CONTROL_DB_USER=
RAG_CONTROL_DB_PASSWORD=

# R-26 backup (HA-4): dedicated minimal-privilege read-only login for pg_dump
# (dual-review seat2-②). Provisioned once on the database side via the SQL in
# ai-docs/delivery/harness/ha-4-backup-runbook.md §1 — never by the migration
# CLI — and consumed only inside BACKUP_DATABASE_URL (never mounted into any
# node process). Leave both values empty in this committed template.
BACKUP_DB_USER=
BACKUP_DB_PASSWORD=
