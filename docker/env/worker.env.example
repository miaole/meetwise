NODE_ENV=development
DATABASE_URL=postgresql://meetwise:meetwise_dev_password@localhost:54329/meetwise
# 仅题库构建/重建 worker 使用的独立低权限 PostgreSQL 登录。它必须是
# QBANK_CONTROL_DB_USER 所 provision 的账户，不能与 DATABASE_URL 共用；缺失时本地题库重建失败关闭。
# 生产连接必须使用 TLS（传输层加密）与独立 secret manager（密钥管理服务）注入，绝不提交真实连接串。
QBANK_CONTROL_DATABASE_URL=
# 通用/全格式 RAG 控制面的独立低权登录。当前 Worker 只在该值挂载时
# 验证身份与 SECURITY DEFINER/RLS 目录；真实 rebuild/outbox 执行器尚未实现，
# 因此不得把“连接校验通过”描述为通用 RAG 已上线或已可发布。
RAG_CONTROL_DATABASE_URL=
REDIS_URL=redis://localhost:63799/0
# RAG 热缓存必须走独立的受管 Redis/Tair 端点；生产只接受 rediss://（TLS）。
# 不要复用通用 REDIS_URL，也不要把连接串或 HMAC key 提交到 Git。
RAG_REDIS_URL=
RAG_REDIS_TOPOLOGY=standalone
RAG_REDIS_CONNECT_TIMEOUT_MS=1000
RAG_REDIS_COMMAND_TIMEOUT_MS=1000
# 至少 32 随机字符。仅用于把 principal/query/recipe 等身份字段做不可逆 HMAC；每次轮转会冷启动缓存。
RAG_QBANK_CACHE_HASH_KEY=
# 至少 32 随机字符。岗位语义 revision 的输入 HMAC 密钥（与 API 共用同一把）：证明 revision 由
# 可信服务派生，调用方伪造 digest 也过不了重校验。API（createJob/updateJob 写 HMAC）与 Worker
#（classifyJobRoute 重校验）都读取它；缺失时建岗/编辑/路由一律失败关闭（fail-closed）。
RAG_JOB_ROUTE_INPUT_HASH_KEY=
# 至少 32 随机字符。自由文本专项训练 goal 的输入 HMAC 密钥（与 API 共用同一把）：证明 revision 由
# 可信服务派生，调用方伪造 digest 也过不了重校验。缺失时自由文本自动漏斗失败关闭（fail-closed）。
RAG_FREE_TEXT_ROUTE_INPUT_HASH_KEY=
OBJECT_STORAGE_ENDPOINT=http://localhost:9009
OBJECT_STORAGE_BUCKET=meetwise-local
OBJECT_STORAGE_ACCESS_KEY=meetwise
OBJECT_STORAGE_SECRET_KEY=meetwise_dev_password
OPENAI_API_KEY=

# --- 文本路由（仅 Worker）---
# 主文本路由与 Qwen 备用路由都只用于 OpenAI-compatible /chat/completions。
# 不要把这两把 Key 复用于 DashScope 原生语音、embedding 或 rerank；它们在下面
# 由 DASHSCOPE_* 单独配置。真实 Key 仅来自受管 secret，永不写入本文件或 .env。
# BAILIAN-04: endpoint 不再接受自由 URL。MODEL_ENDPOINT_PROFILE 是受控版本化 profile id
# （deepseek-cn-public → api.deepseek.com；dashscope-cn-beijing → dashscope.aliyuncs.com/compatible-mode/v1）。
# 旧 MODEL_BASE_URL / MODEL_BACKUP_BASE_URL 一旦出现即拒绝启动。
MODEL_ENDPOINT_PROFILE=deepseek-cn-public
MODEL_API_KEY=
MODEL_NAME=deepseek-v4-pro
MODEL_FAST_NAME=deepseek-v4-flash
# BAILIAN-03: 轮换残留机械校验（可选）。指纹 = SHA-256(Key) 前 16 字符；撤销清单逗号分隔。
# 不填指纹 = 不做该 Key 比对；撤销清单命中恒拒绝启动。
MODEL_API_KEY_FINGERPRINT=
MODEL_REVOKED_KEY_FINGERPRINTS=

# --- DashScope 原生能力（与文本路由凭据隔离）---
# 原生 adapter 只读取 DASHSCOPE_*，绝不回退 MODEL_*。当前 API OCR/批量语音/
# 流式语音均 fail-closed；Worker 的 embedding 直连也尚未有 operation binding。
# BAILIAN-03/04: 单一 DASHSCOPE_API_KEY 横跨 6 能力已拆分——每个 adapter 只取自己那把 key，
# 缺即 *_not_configured，绝不回退到别的 key 变量。旧 DASHSCOPE_API_KEY 一旦出现即拒绝启动。
# endpoint、模型名与所属业务空间必须由控制台当次核对；下列值为非密配置占位，
# 并不表示任何能力已经获准或生产启用。
DASHSCOPE_EMBED_API_KEY=
DASHSCOPE_RERANK_API_KEY=
DASHSCOPE_ASR_API_KEY=
DASHSCOPE_TTS_API_KEY=
DASHSCOPE_STREAM_ASR_API_KEY=
DASHSCOPE_STREAM_TTS_API_KEY=
# OCR 视觉专用 Key（B2.6）：与文本主 Key 隔离。MODEL-OP-01 前 API OCR 仍 fail-closed，暂留空。
DASHSCOPE_VISION_API_KEY=
DASHSCOPE_EMBED_API_KEY_FINGERPRINT=
DASHSCOPE_RERANK_API_KEY_FINGERPRINT=
DASHSCOPE_ASR_API_KEY_FINGERPRINT=
DASHSCOPE_TTS_API_KEY_FINGERPRINT=
DASHSCOPE_STREAM_ASR_API_KEY_FINGERPRINT=
DASHSCOPE_STREAM_TTS_API_KEY_FINGERPRINT=
DASHSCOPE_VISION_API_KEY_FINGERPRINT=
DASHSCOPE_REVOKED_KEY_FINGERPRINTS=
# endpoint 不接受 URL 注入。公开北京 profile 是默认值；若使用受控工作空间
# host，选择 cn-beijing-workspace 并填写非密 workspace id，运行时会构造固定路径。
DASHSCOPE_ENDPOINT_PROFILE=cn-beijing-public
DASHSCOPE_WORKSPACE_ID=
DASHSCOPE_ASR_MODEL=qwen-audio-turbo-latest
DASHSCOPE_TTS_MODEL=qwen-tts
DASHSCOPE_EMBED_MODEL=text-embedding-v4
DASHSCOPE_RERANK_MODEL=gte-rerank-v2
DASHSCOPE_VISION_MODEL=qwen-vl-max
DASHSCOPE_STREAM_ASR_MODEL=paraformer-realtime-v2
DASHSCOPE_STREAM_TTS_MODEL=cosyvoice-v1

# --- 模型调用时限（API/worker 启动时统一校验）---
# execution（网关执行截止）与 transport（HTTP 传输截止）范围均为 1,000–120,000 毫秒，且 transport 必须不大于 execution。
# wait 是同一幂等键发现另一个调用已 dispatching 时的轮询总预算，范围为 100–120,000 毫秒。
MODEL_TIMEOUT_MS=30000
MODEL_EXECUTION_TIMEOUT_MS=35000
MODEL_INVOCATION_WAIT_MS=35000
# 已派发后数据库终态未写入时，超过此窗口由 worker 只冻结为 unknown（未知），绝不自动重发或释放费用。
# 允许范围 35,000–3,600,000 毫秒，且必须大于 MODEL_EXECUTION_TIMEOUT_MS + 30,000 毫秒终态化宽限；每个主体每拍最多处理 MODEL_INVOCATION_RECONCILE_BATCH 条。
MODEL_INVOCATION_RECONCILE_AFTER_MS=120000
MODEL_INVOCATION_RECONCILE_BATCH=100
# 用户可见作业正常由 PostgreSQL committed `wake` 立即唤醒；此值仅是
# 监听断线、遗漏通知、租约恢复和到期报告重试的有界扫描间隔（1,000–60,000 ms）。
WORKER_JOB_RECONCILE_INTERVAL_MS=5000
# 面试公平调度（仅面试队列）。per-owner 是数据库未过期 running 计数围栏（跨副本生效，默认 1）。
# global 是**本进程**同时 drainOnce 上限（默认 4），不是集群全局锁。只接受无符号十进制正整数；
# 非法值、小数、科学计数法或 per-owner>global 使 worker 在任何消费循环启动前失败。
WORKER_INTERVIEW_PER_OWNER_INFLIGHT=1
WORKER_INTERVIEW_GLOBAL_INFLIGHT=4
# 最多同时在途的模型请求（1–1000）；RPM=0 表示不额外按每分钟节流（0–1000000）。
MODEL_MAX_CONCURRENT=4
MODEL_RPM=0

# --- RAG 费用治理（生产强制）---
# 生产下 RAG_COST_ENFORCEMENT 默认为 enforce；缺任一字段 worker 会拒绝启动，避免“只记账、不拦截”。
# 单位是 micro-CNY：1 元 = 1,000,000；text-embedding-v4 在 2026-08-03 的公开价格 0.5 元/百万输入 token = 500000。
# 价格变更必须改 RAG_EMBED_PRICE_REVISION，旧账本会保留当时费率；不要覆盖旧 revision。
RAG_COST_ENFORCEMENT=observe
RAG_EMBED_MAX_INPUT_TOKENS=16000
RAG_EMBED_BILLING_PROVIDER=dashscope
RAG_EMBED_BILLING_MODEL=text-embedding-v4
RAG_EMBED_BILLING_REGION=cn-beijing
RAG_EMBED_PRICE_REVISION=2026-08-03
RAG_EMBED_INPUT_MICRO_CNY_PER_MILLION=500000
RAG_EMBED_PRICE_SOURCE_URL=https://help.aliyun.com/zh/model-studio/text-embedding-v4
RAG_EMBED_MONTHLY_BUDGET_MICRO_CNY=100000000
RAG_EMBED_BUDGET_SCOPE=rag-embedding-prod

# --- 文本/视觉模型费用治理（生产强制）---
# 模型网关在实际 HTTP 发送前，对输入+输出 token 上限做预算预留；超时、5xx、断链或响应损坏进入 unknown，禁止自动重发。
# 金额同样是 micro-CNY（1 元 = 1,000,000）。每个实际模型名必须有独立的、可追溯价格 revision；不要复用 revision 覆盖旧费率。
MODEL_COST_ENFORCEMENT=observe
MODEL_COST_BUDGET_SCOPE=model-inference-prod
MODEL_COST_MONTHLY_BUDGET_MICRO_CNY=100000000
MODEL_PRIMARY_BILLING_PROVIDER=deepseek
MODEL_PRIMARY_BILLING_MODEL=deepseek-v4-pro
MODEL_PRIMARY_BILLING_REGION=cn-mainland
MODEL_PRIMARY_PRICE_REVISION=
MODEL_PRIMARY_INPUT_MICRO_CNY_PER_MILLION=
MODEL_PRIMARY_OUTPUT_MICRO_CNY_PER_MILLION=
MODEL_PRIMARY_PRICE_SOURCE_URL=
MODEL_PRIMARY_MAX_INPUT_TOKENS=16000
MODEL_PRIMARY_MAX_OUTPUT_TOKENS=4000
# 必须由对应模型当前上下文窗口核对后填写。`utf8-bytes-v1` 是保守输入估算，
# 返回 usage 只用于校准；unknown/missing window 不能派发 billable text operation。
MODEL_PRIMARY_CONTEXT_WINDOW_TOKENS=
MODEL_PRIMARY_CONTEXT_ESTIMATOR=utf8-bytes-v1
MODEL_PRIMARY_CONTEXT_SAFETY_MARGIN_TOKENS=
MODEL_FAST_BILLING_PROVIDER=deepseek
MODEL_FAST_BILLING_MODEL=deepseek-v4-flash
MODEL_FAST_BILLING_REGION=cn-mainland
MODEL_FAST_PRICE_REVISION=
MODEL_FAST_INPUT_MICRO_CNY_PER_MILLION=
MODEL_FAST_OUTPUT_MICRO_CNY_PER_MILLION=
MODEL_FAST_PRICE_SOURCE_URL=
MODEL_FAST_MAX_INPUT_TOKENS=16000
MODEL_FAST_MAX_OUTPUT_TOKENS=4000
MODEL_FAST_CONTEXT_WINDOW_TOKENS=
MODEL_FAST_CONTEXT_ESTIMATOR=utf8-bytes-v1
MODEL_FAST_CONTEXT_SAFETY_MARGIN_TOKENS=

# --- 跨供应商 failover（模型高可用；配置驱动，见 apps/worker/src/interview-service.ts withFailover/failoverModel）---
# 配齐下面两个变量即启用 Qwen backup 端点：只有 primary（DeepSeek 文本主模型）在**派发前**已知不可用（例如熔断已打开）时，才允许选择备用。已派发后的 429（请求过多）、5xx（服务端错误）、超时或断线一律冻结为 unknown（未知），绝不切 backup 或同键重发。当前 primary/backup 费用策略不同的 half-open 切换仍是待实现项，不得把本配置写成完整高可用承诺。
# 二者都不配 ⇒ 退化为单端点（向后兼容，无多供应商冗余，即单点故障；诚实起见：此时 failover 不生效）。
# backup 端点由受控 profile id 指定（闭集注册表，见 MODEL_BACKUP_ENDPOINT_PROFILE），不接受自由 URL。
# 必须与对应百炼业务空间 Key/区域匹配。指纹/撤销清单校验同主 Key（B3）。
MODEL_BACKUP_ENDPOINT_PROFILE=dashscope-cn-beijing
MODEL_BACKUP_API_KEY=
MODEL_BACKUP_API_KEY_FINGERPRINT=
MODEL_BACKUP_NAME=qwen-plus
MODEL_FAST_BACKUP_NAME=qwen-turbo
MODEL_BACKUP_BILLING_PROVIDER=dashscope
MODEL_BACKUP_BILLING_MODEL=qwen-plus
MODEL_BACKUP_BILLING_REGION=cn-beijing
MODEL_BACKUP_PRICE_REVISION=
MODEL_BACKUP_INPUT_MICRO_CNY_PER_MILLION=
MODEL_BACKUP_OUTPUT_MICRO_CNY_PER_MILLION=
MODEL_BACKUP_PRICE_SOURCE_URL=
MODEL_BACKUP_MAX_INPUT_TOKENS=
MODEL_BACKUP_MAX_OUTPUT_TOKENS=
MODEL_BACKUP_CONTEXT_WINDOW_TOKENS=
MODEL_BACKUP_CONTEXT_ESTIMATOR=utf8-bytes-v1
MODEL_BACKUP_CONTEXT_SAFETY_MARGIN_TOKENS=
MODEL_FAST_BACKUP_BILLING_PROVIDER=dashscope
MODEL_FAST_BACKUP_BILLING_MODEL=qwen-turbo
MODEL_FAST_BACKUP_BILLING_REGION=cn-beijing
MODEL_FAST_BACKUP_PRICE_REVISION=
MODEL_FAST_BACKUP_INPUT_MICRO_CNY_PER_MILLION=
MODEL_FAST_BACKUP_OUTPUT_MICRO_CNY_PER_MILLION=
MODEL_FAST_BACKUP_PRICE_SOURCE_URL=
MODEL_FAST_BACKUP_MAX_INPUT_TOKENS=
MODEL_FAST_BACKUP_MAX_OUTPUT_TOKENS=
MODEL_FAST_BACKUP_CONTEXT_WINDOW_TOKENS=
MODEL_FAST_BACKUP_CONTEXT_ESTIMATOR=utf8-bytes-v1
MODEL_FAST_BACKUP_CONTEXT_SAFETY_MARGIN_TOKENS=
LANGSMITH_API_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://us.cloud.langfuse.com
LANGFUSE_TRACING_ENABLED=false
# 至少 32 随机字节；只用于 HMAC 伪名化外送关联，不能复用数据库/支付/会话密钥。
LANGFUSE_CORRELATION_SECRET=
