NODE_ENV=development
DATABASE_URL=postgresql://meetwise:meetwise_dev_password@localhost:54329/meetwise
REDIS_URL=redis://localhost:63799/0
OBJECT_STORAGE_ENDPOINT=http://localhost:9009
OBJECT_STORAGE_BUCKET=meetwise-local
OBJECT_STORAGE_ACCESS_KEY=meetwise
OBJECT_STORAGE_SECRET_KEY=meetwise_dev_password
OPENAI_API_KEY=

# --- 跨供应商 failover（模型高可用；配置驱动，见 apps/worker/src/interview-service.ts withFailover/failoverModel）---
# 配齐下面三个变量即启用 backup 端点：primary（境内主模型）熔断打开 / 持续 429 / 超时 → 秒级切 backup（另一 key 或另一供应商的 OpenAI 兼容端点）。
# 三者都不配 ⇒ 退化为单端点（向后兼容，无多供应商冗余，即单点故障；诚实起见：此时 failover 不生效）。
# MODEL_BACKUP_NAME 不设时复用 primary 的模型名。backup 端点须同样 OpenAI 兼容（/chat/completions）。
# 合规注意：简历/PII 请求只能走境内模型——backup 也必须是境内端点，勿把 backup 指向境外供应商（见 agent-runtime.md §5 区域门）。
MODEL_BACKUP_BASE_URL=
MODEL_BACKUP_API_KEY=
MODEL_BACKUP_NAME=
LANGSMITH_API_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://us.cloud.langfuse.com
LANGFUSE_TRACING_ENABLED=false
