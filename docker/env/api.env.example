NODE_ENV=development
PORT=3001
DATABASE_URL=postgresql://meetwise:meetwise_dev_password@localhost:54329/meetwise
REDIS_URL=redis://localhost:63799/0
OBJECT_STORAGE_ENDPOINT=http://localhost:9009
OBJECT_STORAGE_BUCKET=meetwise-local
OBJECT_STORAGE_ACCESS_KEY=meetwise
OBJECT_STORAGE_SECRET_KEY=meetwise_dev_password
JWT_SECRET=replace-with-local-secret
# 至少 32 随机字符。岗位语义 revision 的输入 HMAC 密钥（与 worker 共用同一把）：把
# title/description/competencies 的 canonical digest 做不可逆 HMAC。createJob/updateJob 建岗/
# 编辑时写 revision 需要它；缺失时建岗/编辑失败关闭（fail-closed）。绝不写入真实值或真实 .env。
RAG_JOB_ROUTE_INPUT_HASH_KEY=
# 至少 32 随机字符。自由文本专项训练 goal 的输入 HMAC 密钥（与 worker 共用同一把）：把 goal 的
# canonical digest 做不可逆 HMAC，证明 revision 由可信服务派生，伪造 digest 过不了重校验。
# 缺失时自由文本自动漏斗失败关闭（fail-closed）。绝不写入真实值或真实 .env。
RAG_FREE_TEXT_ROUTE_INPUT_HASH_KEY=
OPENAI_API_KEY=
# OCR remains disabled until it has a typed MODEL-OP-01 binding (cost, media
# budget, deletion and attempt semantics). Keep this at 0 in every environment
# until a typed OCR binding is delivered; compose also defaults it to 0.
OCR_ENABLED=0
# API 与 worker 使用相同模型 deadline（截止时间）契约；启动时非法值会 fail-fast（快速失败）。
MODEL_TIMEOUT_MS=30000
MODEL_EXECUTION_TIMEOUT_MS=35000
MODEL_INVOCATION_WAIT_MS=35000
MODEL_MAX_CONCURRENT=4
MODEL_RPM=0
LANGSMITH_API_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://us.cloud.langfuse.com
LANGFUSE_TRACING_ENABLED=false
LANGFUSE_CORRELATION_SECRET=
